# Núcleo — variables de entorno. Copiá este archivo a .env y completá lo que falte.
# Ningún valor real va al repositorio: .env está en .gitignore.

# Entorno: local | test | production. "test" fuerza el proveedor de pagos simulado.
APP_ENV=local
# URL pública de la app (se usa en back_urls de Mercado Pago, emails y Better Auth).
APP_URL=http://localhost:3030

# Base de datos (docker compose expone Postgres en el puerto 5433).
DATABASE_URL=postgres://nucleo:nucleo@localhost:5433/nucleo
# Base aparte para los tests de integración (la crea docker/initdb).
DATABASE_URL_TEST=postgres://nucleo:nucleo@localhost:5433/nucleo_test

# Better Auth: cadena aleatoria de 32+ caracteres (openssl rand -base64 32).
BETTER_AUTH_SECRET=

# Cuentas demo: botones "Entrar como alumno demo" / "Entrar como admin demo".
# DEMO_MODE=1 los muestra; la contraseña se usa en el seed y en el login demo.
DEMO_MODE=1
DEMO_PASSWORD=

# Mercado Pago Checkout Pro (cuenta de prueba argentina, ARS).
# Sin MP_ACCESS_TOKEN, en local se usa el checkout simulado (ver README).
MP_ACCESS_TOKEN=
# Clave secreta de la notificación webhook (Tus integraciones → Webhooks → Clave secreta).
MP_WEBHOOK_SECRET=
# Opcional: forzar proveedor. "simulado" solo se acepta con APP_ENV=local o test.
PAGOS_PROVEEDOR=

# Emails: SMTP (Mailpit en local) o Resend. Sin ninguno, se registran en el log.
SMTP_URL=smtp://localhost:1026
RESEND_API_KEY=
EMAIL_FROM="Núcleo <hola@nucleo.test>"

# Tareas programadas: Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
