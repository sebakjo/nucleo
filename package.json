{
  "name": "nucleo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3030",
    "build": "next build",
    "start": "next start --port 3030",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db mailpit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrar.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "cron": "tsx scripts/cron-local.ts",
    "setup": "pnpm db:up && pnpm db:migrate && pnpm db:migrate --test && pnpm db:seed",
    "lighthouse": "node scripts/lighthouse.mjs",
    "metricas:tests": "tsx scripts/metricas-tests.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "better-auth": "^1.7.14",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.16.0",
  "type": "module",
  "description": "Núcleo: turnos con pago para un estudio de pilates reformer. Demo de portafolio \"de prototipo a producción\"."
}
